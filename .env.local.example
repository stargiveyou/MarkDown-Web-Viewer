# .env.local.example
#
# 이 파일을 `.env.local`로 복사한 뒤 실제 값을 채운다.
#   cp .env.local.example .env.local
#
# 규칙 (보안 불변식 6):
# - `.env.local`은 절대 커밋하지 않는다 (.gitignore 확인).
# - 어떤 키에도 `NEXT_PUBLIC_` 접두사를 붙이지 않는다.
#   붙이는 순간 클라이언트 번들에 인라인되어 시크릿이 공개된다.
# - Webhook URL과 SESSION_SECRET은 서버 코드에서만 참조한다.

# ---------------------------------------------------------------------------
# 저장소
# ---------------------------------------------------------------------------

# 단일 저장소 루트 (절대 경로). 업로드·읽기·편집 대상이 모두 이 하위로 강제된다.
# os.homedir() 등 코드 내 하드코딩 폴백을 두지 않으므로 이 값은 필수다.
MARKDOWN_ROOT=/Users/<user>/MarkdownDocs

# ---------------------------------------------------------------------------
# 인증 (ADR-005)
# ---------------------------------------------------------------------------

# 단일 사용자 로그인 패스워드의 **해시**. 평문을 넣지 않는다.
# 비교는 timing-safe로 수행한다.
SESSION_PASSWORD=

# 세션 쿠키 서명 키. 최소 32바이트 랜덤.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 업로드 검증 (보안 불변식 3)
# ---------------------------------------------------------------------------

# 업로드 크기 상한(bytes). 초과 시 413. 예: 20MB
UPLOAD_MAX_BYTES=20971520

# 확장자 화이트리스트(쉼표 구분, 소문자). 목록 밖은 415.
ALLOWED_EXTENSIONS=md,markdown,png,jpg,jpeg,gif,webp,svg

# ---------------------------------------------------------------------------
# Rate limiting (보안 불변식 7) — /api/upload, /api/share/notify
# ---------------------------------------------------------------------------

# 윈도 당 최대 요청 수. 초과 시 429.
RATE_LIMIT_MAX=30

# 윈도 길이(초).
RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# 공유 · 알림 (ADR-004 / ADR-008) — 서버 전용
# ---------------------------------------------------------------------------

# 미설정 시 해당 채널 공유는 비활성으로 처리한다(500이 아니라 명시적 거부).
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

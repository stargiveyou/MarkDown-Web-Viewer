# .env.local.example
#
# 이 파일을 `.env.local`로 복사한 뒤 실제 값을 채운다.
#   cp .env.local.example .env.local
#
# 규칙 (보안 불변식 6):
# - `.env.local`은 절대 커밋하지 않는다 (.gitignore 확인).
# - 어떤 키에도 `NEXT_PUBLIC_` 접두사를 붙이지 않는다.
#   붙이는 순간 클라이언트 번들에 인라인되어 시크릿이 공개된다.
# - Webhook URL과 SESSION_SECRET은 서버 코드에서만 참조한다.

# ---------------------------------------------------------------------------
# 저장소
# ---------------------------------------------------------------------------

# 단일 저장소 루트 (절대 경로). 업로드·읽기·편집 대상이 모두 이 하위로 강제된다.
# os.homedir() 등 코드 내 하드코딩 폴백을 두지 않으므로 이 값은 필수다.
MARKDOWN_ROOT=/Users/<user>/MarkdownDocs

# ---------------------------------------------------------------------------
# 인증 (ADR-005)
# ---------------------------------------------------------------------------

# 단일 사용자 로그인 패스워드의 **해시**. 평문을 넣지 않는다.
# 비교는 timing-safe(scrypt + crypto.timingSafeEqual)로 수행한다.
#
# 생성:
#   npm run hash-password              # 대화형(입력이 화면에 표시되지 않음)
#   npm run hash-password -- '평문'     # 인자 전달(셸 히스토리 주의)
#
# 형식: scrypt:<N>:<r>:<p>:<saltBase64>:<hashBase64>
#
# 구분자가 `$`가 아니라 `:`인 것은 의도적이다 — dotenv가 `$`를 변수 참조로 해석해
# 따옴표로 감싸도 값을 잘라먹기 때문이다. 생성된 값을 그대로 붙여 넣으면 된다.
# 이 형식이 아니면 서버가 기동 시점에 실패한다(src/lib/env.ts).
SESSION_PASSWORD=

# 세션 쿠키 서명 키(HMAC-SHA256). 최소 32자 — 32바이트 랜덤을 hex로 쓰면 64자다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 이 값을 교체하면 발급된 모든 세션 쿠키가 즉시 무효가 된다(= 강제 전면 로그아웃).
# 세션 저장소를 두지 않는 stateless 설계라 그 외의 즉시 무효화 수단은 없다.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# 업로드 검증 (보안 불변식 3)
# ---------------------------------------------------------------------------

# 업로드 크기 상한(bytes). 초과 시 413. 예: 20MB
UPLOAD_MAX_BYTES=20971520

# 확장자 화이트리스트(쉼표 구분, 소문자). 목록 밖은 415.
ALLOWED_EXTENSIONS=md,markdown,png,jpg,jpeg,gif,webp,svg

# ---------------------------------------------------------------------------
# Rate limiting (보안 불변식 7) — /api/upload, /api/share/notify
# ---------------------------------------------------------------------------

# 윈도 당 최대 요청 수. 초과 시 429.
#
# ⚠️ 이 값은 **업로드 기준**이다. 프론트는 "파일 1개 = 요청 1개"로 순차 전송하므로
#    (docs/agent-work/frontend-stage-1-client-contract.md §1)
#    30으로 두면 파일 30개짜리 폴더를 한 번 드롭하는 것만으로 429가 난다.
#    100장 사진 업로드를 정상 사용으로 보고 여유를 둔 값이 120이다.
#
# 공유 알림(10/분)과 로그인(10/5분)은 이 값과 무관하게 코드 내 별도 정책을 쓴다
# — src/lib/rate-limit.ts의 RATE_LIMIT_POLICY.
RATE_LIMIT_MAX=120

# 윈도 길이(초).
RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# 공유 · 알림 (ADR-004 / ADR-008) — 서버 전용
# ---------------------------------------------------------------------------

# 미설정 시 해당 채널 공유는 비활성으로 처리한다(500이 아니라 명시적 거부).
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
